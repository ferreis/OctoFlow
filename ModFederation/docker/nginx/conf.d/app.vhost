client_max_body_size 32M;

upstream frontend_host_app {
    server frontend:5173;
    keepalive 20;    
}

server {

    listen 80 default_server;
    listen [::]:80;
    server_name localhost;
    root /var/www/html;
    index index.html index.htm;



    #https://codingwithmanny.medium.com/configure-self-signed-ssl-for-nginx-docker-from-a-scratch-7c2bcd5478c6
    listen 443 ssl default_server;
    listen [::]:443 ssl  default_server;
    ssl_certificate /var/www/cert/nginx-selfsigned.crt;
    ssl_certificate_key /var/www/cert/nginx-selfsigned.key;

    client_header_buffer_size 5120k;
    large_client_header_buffers 16 5120k;

    # Symfony
    location /ModFederation/api {
        # 'proxy_pass' encaminha a requisição para o servidor da aplicação.
        # Note a barra no final: ela remove o prefixo /sal/ da URL.
        proxy_pass http://127.0.0.1:85/;

        # Estes headers são importantes para que a aplicação receba a URL original.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    location /ModFederation/api/ {
        # 'proxy_pass' encaminha a requisição para o servidor da aplicação.
        # Note a barra no final: ela remove o prefixo /sal/ da URL.
        proxy_pass http://127.0.0.1:85/;

        # Estes headers são importantes para que a aplicação receba a URL original.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    # frontend_ModFederation Vue
    location /ModFederation {
        proxy_pass http://frontend_host_app;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        
        #https://stackoverflow.com/questions/37994515/rails-redirect-to-loses-the-https-protocol-and-goes-to-http        
        #https://ubiq.co/tech-blog/increase-request-timeout-nginx/        
        # Linha abaixo envia o protocolo de origem
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 600;
        proxy_connect_timeout 600;
        proxy_send_timeout 600;
           
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Server $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }

    # Remote Module Federation server (5175) via same origin for HTTPS pages
    location /ModFederation-mf/ {
        proxy_pass http://frontend:5175/;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }
  
}


