{% extends 'emails/base_email.html.twig' %}

{% block subject %}Redefinição de senha - OctoFlow{% endblock %}

{% block preheader %}Instruções para redefinir sua senha{% endblock %}

{% block body %}
<p>Olá{% if user_name is defined and user_name %} {{ user_name }}{% endif %},</p>

<p>Recebemos uma solicitação para redefinir a senha da sua conta. Para alterar sua senha, clique no botão abaixo.</p>

<p>O link expira em {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.</p>

<p>Se você não solicitou a redefinição, ignore este email.</p>
{% endblock %}

{% block action %}
  <a class="button" href="{{ frontend_reset_url }}?token={{ resetToken.token }}">Redefinir Senha</a>
{% endblock %}
