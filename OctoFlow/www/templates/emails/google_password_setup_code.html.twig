{% extends 'emails/base_email.html.twig' %}

{% block subject %}Validação para criar senha - OctoFlow{% endblock %}

{% block preheader %}Use este código para validar seu e-mail e criar sua senha local.{% endblock %}

{% block body %}
<p>Você entrou com Google e agora pode ativar o login por e-mail + senha.</p>

<p>Use o código abaixo na tela do OctoFlow:</p>

<p style="font-size: 28px; font-weight: 800; letter-spacing: 4px; margin: 16px 0; color: #0f172a;">
  {{ verificationCode }}
</p>

<p>Este código expira em {{ expiresInMinutes }} minuto(s).</p>
<p>Conta: <strong>{{ userEmail }}</strong></p>
{% endblock %}
